# Ubuntu Bash Script는 LF 줄바꿈으로 받는다.
*.sh text eol=lf
# Bash Wrapper는 확장자가 없어도 LF를 적용한다.
aws-lab text eol=lf
# 이미지 빌드 정의는 LF로 통일한다.
Dockerfile text eol=lf
# 환경 설정은 LF로 통일하며 Git 제외는 별도로 처리한다.
*.env text eol=lf
# 비밀값 없는 설정 예시도 LF로 받는다.
*.env.example text eol=lf
# Compose 정의는 LF를 사용한다.
*.yaml text eol=lf
# PowerShell은 Windows용 CRLF 정책을 사용한다.
*.ps1 text eol=crlf

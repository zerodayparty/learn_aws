#!/usr/bin/env bash
set -euo pipefail # Wrapper가 실패를 숨기지 않게 한다.
LAB_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd) # 자신의 위치에서 Compose 파일을 찾는다.
cd "$LAB_DIR" # 공식 명령과 같은 작업 디렉터리를 사용한다.
exec docker compose --project-directory "$LAB_DIR" -f "$LAB_DIR/compose.yaml" run --rm aws-lab "$@" # 동일 서비스에 인자를 그대로 전달한다.

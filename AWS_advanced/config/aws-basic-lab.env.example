# 프로젝트 Tag의 이름이다. 비밀값을 넣지 않는다.
PROJECT=aws-basic-lab
# 다른 실습과 구분할 이름이다. 기존 수동 실습을 재사용하지 않는다.
LAB_ID=practice-01
# 자신의 실제 AWS 계정 ID로 직접 바꾼다. 예시는 의도적으로 비어 있다.
EXPECTED_ACCOUNT_ID=
# 과제에서 사용하는 서울 리전이다.
AWS_REGION=ap-northeast-2
# 실습 전용 인증파일의 프로필 이름이다.
AWS_PROFILE=aws-basic
# 실습용 네트워크 주소 범위다.
VPC_CIDR=10.20.0.0/16
# 위 VPC 안에서 사용하는 Public Subnet이다.
SUBNET_CIDR=10.20.1.0/24
# 자신의 현재 인터넷 IPv4와 /32를 입력한다. 전체 공개를 허용하지 않는다.
SSH_ALLOWED_CIDR=
# 서버의 크기다. 무료 여부는 자신의 계정 혜택으로 따로 확인한다.
INSTANCE_TYPE=t3.micro
# 서울 리전 Canonical Ubuntu LTS AMI ID를 직접 확인해서 입력한다.
AMI_ID=
